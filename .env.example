# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Database. SQLite by default (a single file — ideal for cPanel/self-host):
DATABASE_URI=file:./amico.db
# To use Postgres instead, set a postgres:// URL (e.g. Neon):
#   DATABASE_URI=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Payload secret — used to sign JWTs and encrypt data. Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me

# Public base URL (no trailing slash).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Email (lead notifications). Leave SMTP_HOST blank in dev to log emails to the console. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Amico Motors <noreply@amicomotors.co.za>"
LEADS_NOTIFY_TO=amelda@amicomotors.co.za
