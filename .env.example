# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
#   Local dev (portable Postgres):  postgresql://postgres:postgres@127.0.0.1:5433/amico
#   Production (Neon/Supabase):     postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5433/amico

# Payload secret — used to sign JWTs and encrypt data. Generate a long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me

# Public base URL (no trailing slash).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Email (lead notifications). Leave SMTP_HOST blank in dev to log emails to the console. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Amico Motors <noreply@amicomotors.co.za>"
LEADS_NOTIFY_TO=amelda@amicomotors.co.za
