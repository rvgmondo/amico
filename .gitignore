# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js — the production build (.next) IS committed for git deploy to cPanel
# (the shared host cannot build reliably), but never the build cache.
/.next/cache/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# portable PostgreSQL (local dev — binaries + cluster data live in the project)
/vendor/
/.pgdata/

# SQLite database (generated by the seed)
/amico.db
/amico.db-*
*.db
*.db-shm
*.db-wal

# Payload uploaded media (local disk storage)
/media/

# Local image cache used by the seed (extracted from deploy/media.zip)
/.imgcache/

# cPanel deploy artifacts (generated — see DEPLOY-CPANEL.md)
/deploy/

# OS / editor
Thumbs.db
